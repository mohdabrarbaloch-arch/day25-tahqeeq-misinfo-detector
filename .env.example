# ---------------------------------------------------------------------------
# Tahqeeq — every variable the app reads. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------
# development | production | test
# In production the app refuses to start without a real JWT_SECRET, and /docs
# plus /openapi.json are disabled.
ENVIRONMENT=development
DEBUG=false

# --- security ---------------------------------------------------------------
# REQUIRED in production, minimum 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank in development, an ephemeral key is generated once per process —
# which means every restart signs everyone out.
JWT_SECRET=
JWT_ALGORITHM=HS256

# How long an access token stays valid, in minutes. Default 7 days.
ACCESS_TOKEN_TTL_MINUTES=10080

# bcrypt work factor. 12 is a good default; raise it if you can afford the CPU.
BCRYPT_ROUNDS=12

# --- database ---------------------------------------------------------------
# SQLite by default so the project runs with zero setup.
# PostgreSQL (what docker-compose uses):
#   DATABASE_URL=postgresql+psycopg://tahqeeq:tahqeeq@db:5432/tahqeeq
DATABASE_URL=sqlite:///./tahqeeq.db

# --- http -------------------------------------------------------------------
# Comma-separated. Must include the exact origin the browser uses, scheme and
# port included, or the browser will block every API call.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Requests per minute per IP, across all routes.
RATE_LIMIT_PER_MINUTE=60
# Tighter limit for the analysis routes, which do real work.
ANALYZE_RATE_LIMIT_PER_MINUTE=20

# --- url fetching -----------------------------------------------------------
FETCH_TIMEOUT_SECONDS=12
# Hard cap on how much of a response body is read, in bytes.
FETCH_MAX_BYTES=3000000
FETCH_USER_AGENT=Mozilla/5.0 (compatible; TahqeeqBot/1.0; +https://github.com/mohdabrarbaloch-arch)

# DANGER: allows fetching loopback and private addresses. Leave false.
# Only set true in a test environment with no network access to anything real.
ALLOW_PRIVATE_FETCH=false

# --- analysis ---------------------------------------------------------------
# Below this word count, signals that need a full article are skipped and the
# report is marked provisional.
MIN_WORDS_FOR_CONFIDENCE=40
# Upper bound on how much text is analysed, in characters.
MAX_TEXT_CHARS=60000
